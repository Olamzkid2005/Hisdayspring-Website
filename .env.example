# Public origin, read at runtime (server only). Also used for Bachs
# success/cancel URLs, which must be publicly reachable. In production set
# SITE_URL=https://www.hisdayspringfamily.org — in local dev leave it empty so
# the request origin (localhost) is used.
SITE_URL=
# Build-time canonical, sitemap and robots override. Leave unset in production.
# NEXT_PUBLIC_SITE_URL=

# Optional escape hatch for sandbox keys on a production build. Leave unset.
# ALLOW_SANDBOX_PAYMENTS_IN_PRODUCTION=

# Public values (safe to expose to the browser)
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=+2348077829444

# Server-only payment secret (never use NEXT_PUBLIC_ for these)
# sk_sandbox_ keys hit sandbox-api.bachs.io, sk_live_ keys hit api.bachs.io —
# going live is a key swap.
BACHS_SECRET_KEY=
# Signing secret of the webhook endpoint (Developer Portal → Webhooks)
BACHS_WEBHOOK_SECRET=
# Optional: override the API base (normally derived from the key prefix).
# BACHS_API_BASE_URL=

# Server-only YouTube values. The channel id must be the numeric UC… id;
# a handle is rejected by the Data API.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCsK_cum0IKbuQ75Va8ty0CA

# Cloudinary image CDN (NEXT_PUBLIC_ value is safe: it's just the cloud name)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hurqcssn
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
